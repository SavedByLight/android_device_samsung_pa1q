service vendor.gatekeeper_spu /system/bin/android.hardware.gatekeeper-service-spu-qti
    class early_hal
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    disabled
    seclabel u:r:recovery:s0

on property:vendor.gatekeeper.is_security_level_spu=1
    enable vendor.gatekeeper_spu